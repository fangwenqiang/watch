:39;a:5:{i:0;s:35:"SHOW FULL COLUMNS FROM `mb_collect`";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1488243783.590636;i:4;a:2:{i:0;a:5:{s:4:"file";s:84:"D:\phpStudy\WWW\www.wangxiwen.com\month11\xiyue\watch\basic\basic\models\Collect.php";s:4:"line";i:36;s:8:"function";s:6:"insert";s:5:"class";s:14:"yii\db\Command";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:106:"D:\phpStudy\WWW\www.wangxiwen.com\month11\xiyue\watch\basic\basic\controllers\home\GoodsShowController.php";s:4:"line";i:23;s:8:"function";s:11:"collect_add";s:5:"class";s:18:"app\models\Collect";s:4:"type";s:2:"->";}}}i:42;a:5:{i:0;s:621:"SELECT
    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
